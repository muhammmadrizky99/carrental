

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model users {
  id       Int    @id @default(autoincrement())
  nama     String @db.VarChar(255)
  email    String @unique @db.VarChar(255)  
  password String @db.VarChar(255)
  role String @db.VarChar(100) @default("pengguna")
  status String @db.VarChar(100) @default("aktiv")

  booking booking[]

  // review review[]
}
model mobil {
  id Int @id @default(autoincrement())
  namaMobil String
  gambar String @db.VarChar(255)
  deskripsi String 
  tipe String
  merek String
  model String
  stok Int  @default(0)
  tahun Int 
  transmisi String
  kapasitasMesin Int 
  kapasitasKursi Int 
  jumlahTas Int 
  jumlahPintu Int 
  warna String
  fiturLainnya String
  ac Boolean 
  harga Float 
  minimum Int 
  maximum Int 


  booking booking[]

  // review review[]
}
model booking {
  id          Int       @id @default(autoincrement())
  tglBooking  DateTime  @default(now())
  tglMulai    DateTime
  tglSelesai  DateTime
  noHp        String
  status      String    @default("pending")
  penggunaId  Int
  mobilId     Int
  pengguna    users     @relation(fields: [penggunaId], references: [id])
  mobil       mobil     @relation(fields: [mobilId], references: [id])
  
  pengembalian pengembalian?
  pembayaran pembayaran[]
  review review[]
}

model pengembalian {
  id                Int      @id @default(autoincrement())
  tanggalPengembalian DateTime @default(now())
  kondisiMobil       String
  statusPengembalian  String    @default("Dikembalikan")
  bookingId          Int @unique
  booking            booking  @relation(fields: [bookingId], references: [id])
}

model pembayaran {
  id                Int       @id @default(autoincrement())
  tglPembayaran     DateTime  @default(now())
  jumlahPembayaran  Float
  metodePembayaran  String    @db.VarChar(100) 
  keterangan        String?   @db.Text
  buktiPembayaran   String?   @db.VarChar(255) 
  bookingId         Int       @unique         
  booking           booking   @relation(fields: [bookingId], references: [id])
}

model review {
    id         Int      @id @default(autoincrement())
    bookingId  Int
    rating     Int      
    komentar   String   
    createdAt  DateTime @default(now())
  //    tglBooking DateTime @default(now())
  // pengguna   users    @relation(fields: [userId], references: [id])
  // userId     Int
  // mobil      mobil    @relation(fields: [mobilId], references: [id])
  // mobilId    Int
    
    booking    booking   @relation(fields: [bookingId], references: [id])
}


