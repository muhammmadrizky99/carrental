generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model users {
  id       Int    @id @default(autoincrement())
  nama     String @db.VarChar(255)
  email    String @unique @db.VarChar(255)  
  password String @db.VarChar(255)
  role String @db.VarChar(100) @default("pengguna")
  status String @db.VarChar(100) @default("aktiv")

  booking booking[]
}
model mobil {
  id Int @id @default(autoincrement())
  namaMobil String
  gambar String @db.VarChar(255)
  deskripsi String 
  tipe String
  merek String
  model String
  stok Int  @default(0)
  tahun Int 
  transmisi String
  kapasitasMesin Int 
  kapasitasKursi Int 
  jumlahTas Int 
  jumlahPintu Int 
  warna String
  fiturLainnya String
  ac Boolean 
  harga Float 
  minimum Int 
  maximum Int 


  booking booking[]
}
model booking {
  id            Int      @id @default(autoincrement())
  tglBooking    DateTime @default(now())
  tglMulai      DateTime
  tglSelesai    DateTime
  noHp          Int
  status        String   @default("pending")
  penggunaId    Int
  pengguna      users    @relation(fields: [penggunaId], references: [id])
  mobilId       Int
  mobil         mobil    @relation(fields: [mobilId], references: [id])
}
