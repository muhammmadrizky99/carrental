

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model users {
  id       Int    @id @default(autoincrement())
  nama     String @db.VarChar(255)
  email    String @unique @db.VarChar(255)  
  password String @db.VarChar(255)
  role String @db.VarChar(100) @default("pengguna")
  status String @db.VarChar(100) @default("aktiv")

  booking booking[]
}
model mobil {
  id Int @id @default(autoincrement())
  namaMobil String
  gambar String @db.VarChar(255)
  deskripsi String 
  tipe String
  merek String
  model String
  stok Int  @default(0)
  tahun Int 
  transmisi String
  kapasitasMesin Int 
  kapasitasKursi Int 
  jumlahTas Int 
  jumlahPintu Int 
  warna String
  fiturLainnya String
  ac Boolean 
  harga Float 
  minimum Int 
  maximum Int 


  booking booking[]
}
model booking {
  id          Int       @id @default(autoincrement())
  tglBooking  DateTime  @default(now())
  tglMulai    DateTime
  tglSelesai  DateTime
  noHp        String
  status      String    @default("pending")
  penggunaId  Int
  mobilId     Int
  pengguna    users     @relation(fields: [penggunaId], references: [id])
  mobil       mobil     @relation(fields: [mobilId], references: [id])
  
  pengembalian pengembalian?
}

model pengembalian {
  id                Int      @id @default(autoincrement())
  tanggalPengembalian DateTime @default(now())
  kondisiMobil       String
  statusPengembalian  String    @default("Dikembalikan")
  bookingId          Int @unique
  booking            booking  @relation(fields: [bookingId], references: [id])
}
